{
  "name": "neffi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:activation-fixture": "node --conditions=react-server --import tsx scripts/dev-activation-fixture.mts",
    "dev:form-submission": "node --conditions=react-server --import tsx scripts/dev-form-submission.mts",
    "build": "node --import tsx scripts/check-psgc-localities.ts && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:check": "drizzle-kit check",
    "db:seed": "tsx scripts/seed-dev.ts",
    "db:erd": "tsx scripts/generate-erd.ts",
    "accounts:set-role": "node --conditions=react-server --import tsx scripts/set-account-role.ts",
    "check:db-concurrency": "node scripts/check-credential-concurrency.mjs",
    "check:provisioning-concurrency": "node --conditions=react-server --import tsx scripts/check-provisioning-concurrency.mts",
    "check:claim-concurrency": "node --conditions=react-server --import tsx scripts/check-claim-concurrency.mts",
    "check:profile-concurrency": "node --conditions=react-server --import tsx scripts/check-profile-concurrency.mts",
    "check:orders-concurrency": "node --conditions=react-server --import tsx scripts/check-orders-concurrency.mts",
    "check:support-concurrency": "node --conditions=react-server --import tsx scripts/check-support-concurrency.mts",
    "check:bundle": "node scripts/check-client-bundle.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@sentry/nextjs": "^11.6.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "geist": "1.7.2",
    "lucide-react": "^1.53.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "uqr": "0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.x"
  }
}

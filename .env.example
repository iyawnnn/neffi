# Neffi environment template. Copy to .env.local (git-ignored) and fill in DEVELOPMENT values only.
# Never put production credentials in .env.local, Vercel Preview, or Vercel Development.
# Validation lives in src/config/env-schema.ts; missing or invalid values fail fast without echoing values.
# Development target: neffi-dev / production (Neon branch name, not application Production); never pre-m2.

# --- Server runtime (required, server-only) ---
# Neon neffi-dev pooled connection string (host contains "-pooler").
DATABASE_URL=
# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Server runtime (conditional) ---
# Required in development and production. In Vercel Preview it may be left unset; it is derived from VERCEL_BRANCH_URL.
BETTER_AUTH_URL=http://localhost:3000

# --- Sign-in (server-only) ---
# Google OAuth web client (dev/preview client only; Testing mode, your Google accounts as test users).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Resend API key (send-only, dev/preview) and sender. Until a domain is verified use: Neffi <onboarding@resend.dev>
RESEND_API_KEY=
AUTH_EMAIL_FROM=
# Optional reply address for support mail. Live acceptance requires a verified Resend sending domain.
SUPPORT_REPLY_TO=

# --- Physical card provisioning (server-only) ---
# Keyed-hash secret for activation codes, at least 32 characters (openssl rand -base64 32). Changing it makes every
# issued, unclaimed activation code unverifiable, so treat it like a database credential and never rotate casually.
ACTIVATION_CODE_SECRET=
# Bare origin written onto NFC cards as <origin>/c/<token> (no path). Development/hardware cards are engineering test
# units and are never sold. Before any pilot or commercial DBC is provisioned, lock the final NFC domain and change this.
CARD_URL_ORIGIN=http://localhost:3000

# --- Profile media (server-only) ---
# Development Cloudinary account (never production). Uploads go browser ? Cloudinary with a short-lived signature
# from Neffi; the secret stays on the server.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Migrations only (never read by the app) ---
# Neon neffi-dev direct (unpooled) connection string, used by drizzle-kit.
DATABASE_URL_UNPOOLED=

# --- Public (not secret, optional) ---
# Sentry DSN; Sentry stays disabled when empty.
NEXT_PUBLIC_SENTRY_DSN=

# --- Platform-provided by Vercel (do not set locally) ---
# VERCEL_ENV, VERCEL_BRANCH_URL, NEXT_PUBLIC_VERCEL_ENV

# --- Added by later milestones (not used yet) ---
# Turnstile, SENTRY_AUTH_TOKEN
